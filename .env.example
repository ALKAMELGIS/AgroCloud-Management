# AgroCloud Management · web app (frontend) settings
# Copy to .env for local development. .env is git-ignored: never commit real keys.
#
# Where API keys live
# -------------------
# Real system: keys are kept on the server only, never in the browser.
#   · OpenWeatherMap key and Sentinel Hub configuration ID: Settings → API keys in the app
#     (saved in the database), or OPENWEATHER_API_KEY / SENTINELHUB_INSTANCE_ID in backend/.env.
#   · Sentinel Hub OAuth client ID / secret: backend/.env only.
# Online demo (GitHub Pages, the Claude preview, localhost copy, APK, iOS):
#   fill in the two DEMO_ lines at the end of this file (or set GitHub secrets of the
#   same names, which win). Every demo build reads them, so no device has to type a key.
#   They are built into the published site, so anyone who opens it can read them:
#   keep this repository private and use keys with usage limits, not production keys.

# Backend API URL
REACT_APP_API_URL=http://localhost:3001/api/v1

# App version: set to match backend APP_VERSION on deploy (shows the update banner when they differ)
REACT_APP_VERSION=0.1.0

# Error tracking (optional, leave empty to disable)
REACT_APP_SENTRY_DSN=

# Legacy, optional: Sentinel Hub WMS for the old Remote Sensing page only.
# The GIS map takes the configuration ID from Settings instead.
REACT_APP_SENTINELHUB_INSTANCE_ID=60de79ca-16a7-4afd-bcbd-0261bf0156fa
REACT_APP_SENTINELHUB_WMS_URL=Public Data (featured collections)

# ── Online demo keys (read by scripts/build-demo.sh) ──
# OpenWeatherMap API key (openweathermap.org → API keys)
DEMO_OPENWEATHER_API_KEY=a30292092a90e4972c9067d1dbf7b22a
# Sentinel Hub configuration ID (apps.sentinel-hub.com → Configuration utility)
DEMO_SENTINELHUB_INSTANCE_ID=60de79ca-16a7-4afd-bcbd-0261bf0156fa
